#:import dp kivy.metrics.dp

<Cabecalho@MDBoxLayout>:
    titulo: ""
    subtitulo: ""
    size_hint_y: None
    height: dp(64)
    padding: dp(12), dp(6)
    spacing: dp(10)
    md_bg_color: app.c_marinho
    Image:
        source: app.brasao
        size_hint: None, None
        size: (dp(44), dp(44)) if app.brasao else (0, 0)
        pos_hint: {"center_y": 0.5}
    MDBoxLayout:
        orientation: "vertical"
        MDLabel:
            text: root.titulo
            bold: True
            font_style: "H6"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            shorten: True
        MDLabel:
            text: root.subtitulo
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: 0.82, 0.88, 0.97, 1
            shorten: True

<Rotulo@MDLabel>:
    theme_text_color: "Custom"
    text_color: app.c_texto
    size_hint_y: None
    height: self.texture_size[1] + dp(6)

<Campo@MDTextField>:
    mode: "rectangle"
    line_color_focus: app.c_marinho
    text_color_focus: app.c_escuro
    size_hint_y: None
    height: dp(56)

<CampoNum@MDTextField>:
    mode: "rectangle"
    input_filter: "float"
    input_type: "number"
    line_color_focus: app.c_marinho
    text_color_focus: app.c_escuro
    size_hint_y: None
    height: dp(56)

<BotaoPrimario@MDRaisedButton>:
    md_bg_color: app.c_marinho
    theme_text_color: "Custom"
    text_color: 1, 1, 1, 1
    size_hint_x: 1
    elevation: 0

<BotaoSecundario@MDFlatButton>:
    theme_text_color: "Custom"
    text_color: app.c_marinho
    size_hint_x: 1

<Cartao@MDBoxLayout>:
    orientation: "vertical"
    adaptive_height: True
    padding: dp(14)
    spacing: dp(6)
    md_bg_color: app.c_claro
    radius: [dp(8)]

<TelaLogin>:
    name: "login"
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 1, 1, 1, 1
        Cabecalho:
            titulo: "SAAE Chalé - MG"
            subtitulo: app.nome_app
        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(24)
                spacing: dp(12)
                Widget:
                    size_hint_y: None
                    height: dp(12)
                Rotulo:
                    text: "Entrar"
                    font_style: "H5"
                    bold: True
                    text_color: app.c_escuro
                Campo:
                    id: ident
                    hint_text: "Telefone ou e-mail"
                Campo:
                    id: senha
                    hint_text: "Senha"
                    password: True
                Rotulo:
                    id: msg
                    text: ""
                    text_color: app.c_vermelho
                BotaoPrimario:
                    text: "ENTRAR"
                    on_release: root.entrar()
                BotaoSecundario:
                    text: "Servidor: " + app.url_api
                    font_size: "11sp"
                    on_release: root.alternar_servidor()
                Campo:
                    id: servidor
                    hint_text: "http://ip-do-servidor:8000"
                    opacity: 0
                    disabled: True
                    height: 0
                BotaoSecundario:
                    id: salvar_servidor
                    text: "Salvar endereço"
                    opacity: 0
                    disabled: True
                    height: 0
                    on_release: root.salvar_servidor()
