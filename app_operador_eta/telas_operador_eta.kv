ScreenManager:
    TelaLogin:
    TelaHome:
    TelaAnalise:
    TelaLavagem:
    TelaHistorico:

<TelaHome>:
    name: "home"
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.c_fundo
        Cabecalho:
            id: cab
        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16)
                spacing: dp(12)
                AvisoCartao:
                    texto: "Lembrete: registre a análise da ETA a cada 2 horas."
                    info: "OPERAÇÃO DA ETA"
                HeroTitulo:
                    prefixo: "Olá, "
                    destaque: "Operador"
                    subtitulo: "Escolha o que registrar agora."
                Cartao:
                    Rotulo:
                        id: prox_titulo
                        text: ""
                        bold: True
                        text_color: app.c_escuro
                    Rotulo:
                        id: prox_texto
                        text: ""
                        font_style: "H6"
                    Rotulo:
                        id: pendentes
                        text: ""
                        font_style: "Caption"
                MDGridLayout:
                    cols: 2
                    adaptive_height: True
                    spacing: dp(10)
                    CartaoAcao:
                        icone: "water"
                        titulo: "Nova análise"
                        texto: "Cloro, pH, turbidez, cor"
                        on_release: root.manager.current = "analise"
                    CartaoAcao:
                        icone: "filter"
                        titulo: "Lavagem de filtro"
                        texto: "Tempo e volume gastos"
                        on_release: root.manager.current = "lavagem"
                    CartaoAcao:
                        icone: "history"
                        titulo: "Histórico"
                        texto: "Pendentes e últimos lançamentos"
                        on_release: root.manager.current = "historico"
                    CartaoAcao:
                        icone: "cloud-upload"
                        titulo: "Enviar pendências"
                        texto: "Sincronizar agora"
                        on_release: root.sincronizar()
                BotaoSecundario:
                    text: "Trocar senha"
                    on_release: root.trocar_senha()
                BotaoSecundario:
                    text: "Sair"
                    on_release: root.sair()
        RodapeSiga:

<TelaAnalise>:
    name: "analise"
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.c_fundo
        Cabecalho:
            titulo: "Nova análise da ETA"
            subtitulo: "Preencha o que foi medido; vírgula ou ponto"
        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(20)
                spacing: dp(10)
                Rotulo:
                    id: hora
                    text: ""
                    bold: True
                    text_color: app.c_escuro
                CampoNum:
                    id: vazao_ls
                    hint_text: "Vazão (L/s)"
                CampoNum:
                    id: turbidez_bruta
                    hint_text: "Turbidez bruta (NTU)"
                CampoNum:
                    id: turbidez_filtrada
                    hint_text: "Turbidez filtrada (NTU)"
                CampoNum:
                    id: turbidez_tratada
                    hint_text: "Turbidez tratada (NTU)"
                CampoNum:
                    id: ph_bruta
                    hint_text: "pH água bruta"
                CampoNum:
                    id: ph_tratada
                    hint_text: "pH água tratada"
                CampoNum:
                    id: cor_bruta
                    hint_text: "Cor bruta (uC)"
                CampoNum:
                    id: cor_tratada
                    hint_text: "Cor tratada (uC)"
                CampoNum:
                    id: cloro_residual
                    hint_text: "Cloro residual (mg/L)"
                CampoNum:
                    id: sulfato_dosagem
                    hint_text: "Dosagem de sulfato"
                CampoNum:
                    id: cloro_dosagem
                    hint_text: "Dosagem de cloro"
                Campo:
                    id: observacoes
                    hint_text: "Observações"
                Rotulo:
                    id: msg
                    text: ""
                    text_color: app.c_vermelho
                BotaoPrimario:
                    text: "REGISTRAR"
                    on_release: root.registrar()
                BotaoSecundario:
                    text: "Voltar"
                    on_release: root.manager.current = "home"

<TelaLavagem>:
    name: "lavagem"
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.c_fundo
        Cabecalho:
            titulo: "Lavagem de filtro"
        MDBoxLayout:
            orientation: "vertical"
            padding: dp(20)
            spacing: dp(10)
            Rotulo:
                id: hora
                text: ""
                bold: True
                text_color: app.c_escuro
            CampoNum:
                id: tempo
                hint_text: "Tempo gasto (min)"
            CampoNum:
                id: volume
                hint_text: "Volume de água gasto (m³)"
            Rotulo:
                id: msg
                text: ""
                text_color: app.c_vermelho
            BotaoPrimario:
                text: "REGISTRAR"
                on_release: root.registrar()
            BotaoSecundario:
                text: "Voltar"
                on_release: root.manager.current = "home"
            Widget:

<TelaHistorico>:
    name: "historico"
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.c_fundo
        Cabecalho:
            titulo: "Histórico"
            subtitulo: "Pendentes, recusados e últimos lançamentos"
        ScrollView:
            MDList:
                id: lista
        BotaoSecundario:
            text: "Voltar"
            on_release: root.manager.current = "home"
