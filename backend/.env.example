# Copie este arquivo para ".env" (na pasta backend) e ajuste. Nada aqui é obrigatório para testar.

# --- Modo ---
# producao desliga a página /docs e liga o cabeçalho HTTPS. Deixe "desenvolvimento" enquanto testa no PC.
SIGA_ENV=desenvolvimento
# 1 = NÃO obriga trocar as senhas de teste (123456 etc.). Use SÓ no seu PC de testes; apague em produção.
SIGA_MODO_TESTE=1

# --- Chaves (o sistema gera sozinho se não existirem; em produção, defina e guarde backup!) ---
# SECRET_KEY=
# CHAVE_CRIPTOGRAFIA=

# --- E-mail dos códigos de recuperação (escolha UM; sem nenhum, o código aparece só no console do servidor) ---
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_REMETENTE=SIGA <nao-responda@seudominio.com.br>
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USUARIO=
# SMTP_SENHA=

# --- Verificação em 2 etapas do administrador (código por e-mail) ---
# auto = liga sozinha quando o e-mail acima estiver configurado | 1 = sempre | 0 = nunca
SIGA_2FA_ADMIN=auto

# --- Atrás de proxy/HTTPS seu (nginx, Caddy): confia no IP real que o proxy informa ---
# SIGA_PROXY_CONFIAVEL=1

# --- Ajustes finos ---
# SIGA_MAX_UPLOAD_MB=15
# SIGA_ACCESS_MINUTOS=30
# SIGA_CORS_ORIGENS=
